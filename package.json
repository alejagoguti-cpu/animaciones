{
  "name": "animaciones",
  "version": "1.0.0",
  "private": true,
  "description": "Videos promocionales de Bitaxus hechos con Remotion",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render BitaxusPromo out/bitaxus-promo.mp4",
    "render:square": "remotion render BitaxusPromoSquare out/bitaxus-promo-square.mp4",
    "still": "remotion still BitaxusPromo out/portada.png --frame=60",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "web": "vite",
    "build:web": "vite build"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "@remotion/fonts": "^4.0.529",
    "@remotion/google-fonts": "4.0.529",
    "@remotion/media": "^4.0.529",
    "@remotion/player": "4.0.529",
    "@remotion/transitions": "4.0.529",
    "@remotion/web-renderer": "^4.0.529",
    "@remotion/zod-types": "^4.0.529",
    "@supabase/supabase-js": "^2.117.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.529",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.1"
  }
}
